// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER  @map("user")
  ADMIN @map("admin")

  @@map("role")
}

enum TransactionType {
  DEPOSIT    @map("deposit")
  WITHDRAWAL @map("withdrawal")
  TRANSFER   @map("transfer")

  @@map("transaction_type")
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name") @db.VarChar(100)
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  accounts             Account[]
  wallets              Wallet[]
  paymentMethods       PaymentMethod[]
  beneficiaries        Beneficiary[]
  notifications        Notification[]
  apiKeys              ApiKey[]
  refreshTokens        RefreshToken[]
  webhookSubscriptions WebhookSubscription[]
  files                File[]

  @@map("users")
}

model Account {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String   @db.VarChar(100)
  currency  String   @db.VarChar(3)
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("accounts")
}

model Transaction {
  id                   String          @id @default(uuid())
  accountId            String          @map("account_id")
  destinationAccountId String?         @map("destination_account_id")
  referenceId          String          @unique @map("reference_id")
  type                 TransactionType
  amount               Decimal         @db.Decimal(12, 2)
  resultingBalance     Decimal         @db.Decimal(12, 2) @map("resulting_balance")
  createdAt            DateTime        @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethods WalletPaymentMethod[]

  @@map("wallets")
}

model PaymentMethod {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   @db.VarChar(20)
  details   Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallets WalletPaymentMethod[]

  @@map("payment_methods")
}

model WalletPaymentMethod {
  walletId        String @map("wallet_id")
  paymentMethodId String @map("payment_method_id")

  wallet        Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@id([walletId, paymentMethodId])
  @@map("wallet_payment_methods")
}

model Beneficiary {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  name          String   @db.VarChar(100)
  accountNumber String   @map("account_number") @db.VarChar(34)
  bankCode      String   @map("bank_code") @db.VarChar(11)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountNumber, bankCode])
  @@map("beneficiaries")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ApiKey {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  keyHash   String    @map("key_hash")
  isRevoked Boolean   @default(false) @map("is_revoked")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model WebhookSubscription {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  url        String
  eventTypes Json     @map("event_types")
  secret     String
  createdAt  DateTime @default(now()) @map("created_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String    @id @default(uuid())
  subscriptionId String    @map("subscription_id")
  eventType      String    @map("event_type")
  payload        Json
  httpStatus     Int?      @map("http_status")
  attempts       Int       @default(0)
  status         String    @default("pending") @db.VarChar(20)
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}

model File {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  originalName String   @map("original_name")
  storagePath  String   @map("storage_path")
  mimeType     String   @map("mime_type")
  size         Int
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("files")
}
